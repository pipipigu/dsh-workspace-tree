{
  "name": "@dsh-external/dsh-workspace-tree",
  "description": "Virtual session folder grouping, move-to-folder menu, and nested workspace subproject manager for DeepSeek Harness (DSH).",
  "version": "0.1.2",
  "author": "pipipigu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pipipigu/dsh-workspace-tree.git"
  },
  "homepage": "https://github.com/pipipigu/dsh-workspace-tree#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "workspace-manager",
    "session-manager",
    "folder-tree"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/plugin/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:types && node build.mjs",
    "build:clean": "rm -rf lib",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:/home/ppz/.volta/tools/image/packages/@deepseek-ai/dsh/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/cordis",
    "@deepseek-ai/dsh-client-runtime": "link:/home/ppz/project/dsh/dsh-genui/node_modules/@deepseek-ai/dsh-client-runtime",
    "@deepseek-ai/dsh-client-ui-primitives": "link:/home/ppz/project/dsh/dsh-genui/node_modules/@deepseek-ai/dsh-client-ui-primitives",
    "@deepseek-ai/dsh-client-ui-slots": "link:/home/ppz/project/dsh/dsh-genui/node_modules/@deepseek-ai/dsh-client-ui-slots",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.29.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
